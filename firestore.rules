rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clinicar: cada conta (uma clínica) lê e escreve SÓ a própria árvore users/{uid}/**.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Tudo o mais é negado (não existe leitura pública nem escrita anônima).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
